# Local development works without these, using SQLite.
# Vercel requires APP_PASSWORD, SESSION_SECRET, and DATABASE_URL (or integration-managed POSTGRES_URL). Never use VITE_ prefixes here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
